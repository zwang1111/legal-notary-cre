# Copy to .env at the repo root. Never commit real values. Testnet only.
# scripts/deploy-base-sepolia.sh loads this file without printing the secrets.
# The CRE CLI is invoked with `cre -e <repo>/.env`, and the variables are also exported.

# Browser login (`cre login`) OR this key. Create the key in the CRE platform:
# Organization → APIs → + Organization API. API keys need deploy access (`cre account access`).
CRE_API_KEY=

# Funded Base Sepolia EOA. Used by forge create and by `cre workflow simulate --broadcast`.
# 32-byte hex, with or without 0x. The deploy script refuses to print it.
CRE_ETH_PRIVATE_KEY=

# Deploy and receipt RPC. `cre workflow simulate --broadcast` still uses cre/project.yaml
# (https://sepolia.base.org). Change both if you switch RPCs.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional constructor override. Default is the MockKeystoneForwarder in cre/notary/forwarders.json.
# FORWARDER=
# FORWARDER_KIND=mock

# demo.sh only. broadcast does not deploy; run scripts/deploy-base-sepolia.sh first.
CRE_MODE=

PAY_TO=0x000000000000000000000000000000000000dEaD
PRICE=10000              # 0.01 USDC (6 decimals)
FACILITATOR_URL=         # optional, e.g. https://x402.org/facilitator to really settle on Base Sepolia
AGENT_PK=                # optional; funded Base Sepolia USDC key, only together with FACILITATOR_URL
